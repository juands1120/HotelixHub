DELIMITER //

CREATE PROCEDURE SP_CancelarReserva(IN p_id_reserva INT)
BEGIN
    UPDATE reserva SET estado = 'Cancelada' WHERE id_reserva = p_id_reserva;
END //

DELIMITER ;

